{
  "name": "agentdesk-agent",
  "version": "0.2.0",
  "private": true,
  "description": "agentdesk-agent — RAG/chat sidecar for agentdesk-api (depends on @mastra/*)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "mastra dev -d src",
    "build": "mastra build -d src",
    "start": "node .mastra/output/index.mjs",
    "start:cli": "mastra start -d src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mastra/core": "^1.51.0",
    "@mastra/memory": "^1.23.0",
    "@mastra/pg": "^1.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "mastra": "^1.19.0",
    "typescript": "^5.8.3"
  }
}