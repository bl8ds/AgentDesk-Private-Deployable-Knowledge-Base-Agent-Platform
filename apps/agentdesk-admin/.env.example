VITE_OIDC_ISSUER=https://auth.example.com
VITE_OIDC_CLIENT_ID=agentdesk_admin_spa
# Absolute API URL (CORS) — leave empty in local .env.development to use Vite proxy
VITE_API_BASE_URL=https://agentdesk-api.example.com
# Dev proxy target when VITE_API_BASE_URL is empty
VITE_API_PROXY_TARGET=https://agentdesk-api.example.com