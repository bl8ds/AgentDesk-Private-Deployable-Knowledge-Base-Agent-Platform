# Server
APP_ENV=development
APP_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agentdesk
DB_SSLMODE=disable
DB_LOG_LEVEL=silent

# Auth: JWKS only (openauth-auth)
AUTH_MODE=jwks
AUTH_JWKS_URL=https://auth.example.com/oauth/jwks
OIDC_ISSUER=https://auth.example.com

# App server credential for POST /api/v1/auth/app-code (Header: X-App-Credential)
APP_SERVICE_CREDENTIAL=dev-app-credential-change-me

# Browser session cookie (payload primary in Redis; PG sessions = audit trail)
SESSION_COOKIE_NAME=agentdesk_session
SESSION_TTL_HOURS=24

# Redis (session store; DB=2 reserved for agentdesk)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# Object storage (MinIO / S3-compatible); StoragePath = object key e.g. docs/{uuid}.pdf
S3_ENDPOINT=https://minio.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agentdesk
S3_USE_PATH_STYLE=true

# Agent HTTP proxy (always on; no stub mode)
AGENT_BASE_URL=http://agentdesk-agent:4111

# 与 agentdesk-agent 一致：加密存储 admin「模型配置」中的 API Key（模型本身不写在 env）
CONFIG_ENCRYPTION_KEY=

# Demo abuse controls
DEFAULT_MONTHLY_TOKEN_QUOTA=200000
CHAT_COMPLETIONS_RATE_LIMIT=10
CHAT_COMPLETIONS_RATE_WINDOW_SEC=60

# CORS
CORS_ORIGINS=https://agentdesk-admin.example.com,https://agentdesk-chat.example.com,http://localhost:5173,http://localhost:5174