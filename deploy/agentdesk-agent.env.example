# Production / compose env for agentdesk-agent
# 模型 URL / 模型名 / API Key：仅在 agentdesk-admin「模型配置」中填写（写入 runtime_ai_settings）。
# 本文件只保留进程基础设施与极少变更的运维参数。
PORT=4111
HOST=0.0.0.0
DATABASE_URL=postgres://root:root@postgres-postgres-1:5432/agentdesk?sslmode=disable

# 与 agentdesk-api 相同，用于解密库内模型密钥（非模型供应商配置）
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# 向量维度（pgvector HNSW 上限 2000）。变更须重建向量索引，勿在 admin 改。
EMBEDDING_DIMENSION=1536