# Production compose env for agentdesk-api (copy to agentdesk-api.env; do not commit secrets)
APP_ENV=production
APP_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# agentdesk-network 内 DNS（compose 容器名）
DB_HOST=postgres-postgres-1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=agentdesk
DB_SSLMODE=disable

AUTH_MODE=jwks
AUTH_JWKS_URL=https://auth.example.com/oauth/jwks
OIDC_ISSUER=https://auth.example.com
APP_SERVICE_CREDENTIAL=change-me

SESSION_COOKIE_NAME=agentdesk_session
SESSION_TTL_HOURS=24

REDIS_HOST=redis-redis-1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=2

# 容器内直连 MinIO（勿走公网 HTTPS）
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=agentdesk
S3_USE_PATH_STYLE=true

AGENT_BASE_URL=http://agentdesk-agent:4111

# 32-byte AES key for sealing AI API keys in runtime_ai_settings (hex64 / base64 / raw32)
# Generate: openssl rand -hex 32
# 与 agentdesk-agent 必须一致；模型本身在 admin「模型配置」中填写，不写在本文件。
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# Demo abuse controls (admin can still override per-user / global in UI)
DEFAULT_MONTHLY_TOKEN_QUOTA=200000
CHAT_COMPLETIONS_RATE_LIMIT=10
CHAT_COMPLETIONS_RATE_WINDOW_SEC=60

CORS_ORIGINS=https://agentdesk-admin.example.com,https://agentdesk-chat.example.com